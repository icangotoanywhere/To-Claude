<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 只需要能找到并拉起 Claude App（安卓 11 起要声明要查询的应用） -->
    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <!-- ip-api.com 免费接口只有 http，作为 ipwho.is 查不到时的备用 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToClaude"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ToClaude.Gate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Claude 打开 / 切回前台时先弹检查卡片（用户在系统「无障碍」里手动打开才生效） -->
        <service
            android:name=".GateService"
            android:exported="true"
            android:label="@string/acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_gate" />
        </service>
    </application>
</manifest>
